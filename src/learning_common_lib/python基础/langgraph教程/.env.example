# LangGraph 教程默认使用真实 OpenAI 兼容接口。
# 注意：这里保存的是教程专用配置；如需离线/确定性回归，可设置 LANGGRAPH_USE_FAKE_LLM=1。

LANGGRAPH_TUTORIAL_OPENAI_API_KEY=xxxxx
LANGGRAPH_TUTORIAL_OPENAI_CHAT_COMPLETIONS_URL=https://xxxxx.com/v1
LANGGRAPH_TUTORIAL_OPENAI_MODEL=gpt-5.4-nano
LANGGRAPH_TUTORIAL_OPENAI_TEMPERATURE=0
LANGGRAPH_TUTORIAL_OPENAI_TIMEOUT_S=60
LANGGRAPH_USE_FAKE_LLM=0
